# ==============================================================================
# Frontend Environment Configuration Template
# Copy this file to '.env' in the frontend directory and update values accordingly:
#   cp .env.template .env
# ==============================================================================

# API Mode Toggle
# Set to 'true' to connect to the FastAPI backend service
# Set to 'false' to run standalone in browser with simulated Mock API service
VITE_USE_REAL_API=true

# Backend API Base URL
# URL where the FastAPI backend server is accessible
VITE_API_BASE_URL=http://localhost:8000
