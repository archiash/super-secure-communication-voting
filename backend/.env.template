# ==============================================================================
# Backend Environment Configuration Template
# Copy this file to '.env' in the backend directory and update values accordingly:
#   cp .env.template .env
# ==============================================================================

# Database Configuration (MongoDB)
# Connection URI used by Beanie ODM to persist voting sessions, elections, and audit logs.
# Local instance: mongodb://localhost:27017
# MongoDB Atlas:  mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/database?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017

# IBM Quantum Platform Integration
# API Token from https://quantum.ibm.com/ (Required when USE_IBM_QUANTUM=true and USE_REAL_IBM_HARDWARE=true)
IBM_TOKEN=your_ibm_quantum_api_token_here

# Quantum Hardware & Execution Toggles
# - Set to 'false': Use local Qiskit Aer simulation (Ideal noise-free channel, QBER = 0.0%)
# - Set to 'true':  Enable IBM Quantum execution (Noise calibration simulation or real QPU hardware)
USE_IBM_QUANTUM=false

# When USE_IBM_QUANTUM=true:
# - Set to 'false': Run local noise-calibrated simulation (~2.82% QBER) without waiting in cloud queue
# - Set to 'true':  Submit quantum circuits to real physical IBM Quantum QPU (e.g., ibm_kingston)
USE_REAL_IBM_HARDWARE=false
