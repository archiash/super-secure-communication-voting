# ==============================================================================
# Backend Environment Configuration Template
# Copy this file to '.env' in the backend directory and update values accordingly:
#   cp .env.template .env
# ==============================================================================

# Database Configuration (MongoDB)
# Local instance default: mongodb://localhost:27017
# MongoDB Atlas example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/database?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017

# IBM Quantum Platform Integration
# Retrieve your API token from: https://quantum.ibm.com/
IBM_TOKEN=your_ibm_quantum_api_token_here

# Quantum Hardware & Execution Toggles
# Set to 'true' to enable cloud IBM Quantum execution, or 'false' for local Qiskit Aer simulation
USE_IBM_QUANTUM=false

# Set to 'true' to execute on real IBM Heron QPU (e.g. ibm_kingston), or 'false' for calibrated noise model
USE_REAL_IBM_HARDWARE=false

# QKD External Simulation API (Optional fallback)
QKD_API_URL=https://api.quantum-simulator.com
